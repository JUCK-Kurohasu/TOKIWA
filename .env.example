# TOKIWA environment for the Docker Compose stack (deploy/compose.yaml).
#
#   cp .env.example .env    # .env is git-ignored. Never commit real keys or passwords.
#   docker compose -f deploy/compose.yaml --env-file .env up -d --build
#
# Every TOKIWA_* variable maps onto backend/src/tokiwa/config.py (nested fields use "__"), e.g.
# TOKIWA_LLM__DAILY_BUDGET_USD -> Settings.llm.daily_budget_usd. This file is passed to the containers as-is.
#
# IMPORTANT: leave optional secrets commented out instead of setting them to an empty value.
# An empty TOKIWA_SERVER__SECRET_KEY= would be used verbatim as the JWT signing key.

# ---------------------------------------------------------------------------------------------------------
# Compose / container
# ---------------------------------------------------------------------------------------------------------
# Image tag to build/run.
TOKIWA_IMAGE=tokiwa:local
# Host interface + port for the UI/API. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes it on the LAN.
TOKIWA_BIND=127.0.0.1
TOKIWA_PORT=8788
# Optional profiles, comma separated: postgres, gate
# COMPOSE_PROFILES=postgres

# ---------------------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------------------
TOKIWA_LOG_LEVEL=INFO
# Public URL users open (used in links / notifications).
TOKIWA_SERVER__BASE_URL=http://localhost:8788
# JSON list. Only needed when the UI is served from a different origin than the API.
# TOKIWA_SERVER__CORS_ORIGINS=["https://tokiwa.example.internal"]
# JWT signing key. Unset = generated once and stored in /data/secret.key (back it up with the database).
# TOKIWA_SERVER__SECRET_KEY=<output of: openssl rand -base64 48>
# Behind a reverse proxy on another host/container: trust its X-Forwarded-* headers (uvicorn setting).
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# ---------------------------------------------------------------------------------------------------------
# Database (default: SQLite file /data/tokiwa.db inside the tokiwa-data volume)
# ---------------------------------------------------------------------------------------------------------
# PostgreSQL: enable the "postgres" profile, choose a URL-safe password (e.g. openssl rand -hex 24) and
# uncomment all four lines. The URL below re-uses the variables above it.
# COMPOSE_PROFILES=postgres
# POSTGRES_USER=tokiwa
# POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string
# TOKIWA_DATABASE__URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/tokiwa

# ---------------------------------------------------------------------------------------------------------
# LLM (optional). Without a key TOKIWA runs with the deterministic mock provider (rule-based fallbacks).
# ---------------------------------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# TOKIWA_LLM__PROVIDER=auto
# TOKIWA_LLM__DAILY_BUDGET_USD=5
# TOKIWA_LLM__MODEL_FAST=claude-haiku-5-5
# TOKIWA_LLM__MODEL_DEEP=claude-opus-5-5
# Self-hosted OpenAI-compatible endpoint instead (Ollama / vLLM):
# TOKIWA_LLM__PROVIDER=openai_compat
# TOKIWA_LLM__OPENAI_BASE_URL=http://ollama:11434/v1

# ---------------------------------------------------------------------------------------------------------
# Vulnerability intelligence (optional API keys raise rate limits)
# ---------------------------------------------------------------------------------------------------------
# TOKIWA_INTEL__ENABLED=true
# TOKIWA_INTEL__NVD_API_KEY=<your NVD API key>
# TOKIWA_INTEL__GITHUB_TOKEN=<read-only GitHub token for GHSA>


# ---------------------------------------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------------------------------------
# TOKIWA_NOTIFY__DEFAULT_WEBHOOK_URL=https://hooks.example.com/...
# TOKIWA_NOTIFY__PUBLIC_UI_URL=https://tokiwa.example.internal

# ---------------------------------------------------------------------------------------------------------
# Gate profile (reverse proxy sensor/enforcer in front of your app)
# ---------------------------------------------------------------------------------------------------------
# 1) docker compose -f deploy/compose.yaml exec tokiwa tokiwa token create gate-1
# 2) paste the token below, set the upstream, then: docker compose ... --profile gate up -d
# TOKIWA_GATE__UPSTREAM=http://host.docker.internal:3000
# TOKIWA_GATE__INGEST_TOKEN=tkw_...
# TOKIWA_GATE__SENSOR_ID=gate-1
# TOKIWA_GATE__TRUST_FORWARDED_FOR=false
# TOKIWA_GATE_BIND=0.0.0.0
# TOKIWA_GATE_PORT=8080
